{
  "id": "/",
  "name": "Kortix CompanyOS",
  "short_name": "Kortix",
  "description": "Open-source CompanyOS: your agents, skills, memory, and connectors in one repo you own. Any model. Self-host or cloud.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "any",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/workspace-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Kortix workspace on desktop: sessions, agents, and the composer."
    },
    {
      "src": "/screenshots/workspace-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Kortix workspace on a phone, installable from the browser menu."
    }
  ],
  "categories": ["productivity", "utilities", "business"],
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.kortix.application",
      "id": "com.kortix.application"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/ie/app/kortix/id6754448524"
    }
  ],
  "prefer_related_applications": false
}
